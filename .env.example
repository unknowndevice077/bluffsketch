# ---------------------------------------------------------------- server
# Copy to server/.env (read by the server via dotenv), or set in your host's dashboard.

# Port the Socket.IO server listens on (Render/Railway/Fly inject PORT automatically).
PORT=3001
# Interface to bind.
HOST=0.0.0.0
# Allowed browser origins, comma-separated. "*" allows any (fine for local dev only).
CLIENT_ORIGIN=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# Optional: path to a built client (client/dist) to serve the whole game from one process.
SERVE_CLIENT_DIR=

# ---------------------------------------------------------------- client
# Copy to client/.env for Vite. Read at build time.

# Public URL of the game server, e.g. https://bluffsketch-api.onrender.com
# Leave empty in dev (Vite proxies /socket.io) or when served from the same origin.
VITE_SERVER_URL=
# Dev only: where Vite's proxy forwards /socket.io.
DEV_SERVER_TARGET=http://localhost:3001
